<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Trip_Participants_Positive</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
    NOT(ISBLANK(TEXT(Number_of_Participants__c))),
    Number_of_Participants__c &lt;= 0
)</errorConditionFormula>
    <errorMessage>Le nombre de participants doit être strictement positif s&apos;il est renseigné.</errorMessage>
</ValidationRule>
